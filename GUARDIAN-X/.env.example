# OMEGA GUARDIAN X — private runtime configuration template
# Preferred: run `ogx env init` to create the real file under OGX external state.
# Copy this template only when you intentionally want to use an explicit OGX_ENV_FILE.
# NEVER commit real credentials. Keep .env permissions private (POSIX: chmod 600).

# Approval email: choose brevo or smtp
OGX_MAIL_PROVIDER=brevo
OGX_BREVO_API_KEY=
OGX_MAIL_FROM_EMAIL=
OGX_MAIL_FROM_NAME=OMEGA GUARDIAN X
OGX_APPROVER_EMAIL=
OGX_APPROVER_SUBJECT=
OGX_ACTOR_SUBJECT=
OGX_APPROVAL_TTL_MINUTES=30

# For Bravo/another branded provider, choose smtp only if it supplies outbound SMTP relay credentials.
# SMTP-compatible provider fields (only when OGX_MAIL_PROVIDER=smtp)
OGX_SMTP_HOST=
OGX_SMTP_PORT=587
OGX_SMTP_USERNAME=
OGX_SMTP_PASSWORD=

# Optional Git hosting API credentials — least privilege only
OGX_GITHUB_TOKEN=
OGX_GITHUB_API_BASE=https://api.github.com
OGX_GITLAB_TOKEN=
OGX_GITLAB_API_BASE=https://gitlab.com/api/v4
OGX_BITBUCKET_TOKEN=
OGX_GITEA_TOKEN=
OGX_FORGEJO_TOKEN=

# Keep disabled. This bypasses email approval for confirmed writes when enabled.
OGX_ALLOW_UNAPPROVED_WRITES=0

# OGX_HOME and OGX_ENV_FILE are bootstrap overrides and must be set in the OS environment.
