{
  "schema_version": "1.0",
  "description": "Shared identity golden vectors for the canonical and drop-in distributions. Built from the schema in GUARDIAN-X/docs/UNIVERSAL_RELOCATION_IDENTITY_DESIGN.md section 6.1 and frozen; never regenerate these values to make a failing test pass.",
  "design_reference": "GUARDIAN-X/docs/UNIVERSAL_RELOCATION_IDENTITY_DESIGN.md#114-shared-golden-vectors",
  "implementations": {
    "canonical": {
      "identity_module": "ogx.pap.identity",
      "status": "implemented",
      "state_key_hex_length": 16
    },
    "drop-in": {
      "identity_module": null,
      "status": "not-implemented",
      "state_key_hex_length": 12
    }
  },
  "canonicalization": {
    "encoding": "utf-8",
    "sort_keys": true,
    "ensure_ascii": false,
    "separators": [
      ",",
      ":"
    ],
    "excluded_fields": [
      "identity_hash"
    ],
    "defaulted_fields": {
      "description": ""
    },
    "canonical_fields": [
      "schema_version",
      "project_id",
      "project_name",
      "description",
      "created_at",
      "created_by",
      "ogx_version"
    ],
    "hash_algorithm": "sha256",
    "hash_prefix": "sha256:"
  },
  "vectors": [
